# Balon — production environment template
# Kopiraj u .env i popuni vrijednosti. NIKAD ne commit-uj .env file.

# === Database ===
POSTGRES_USER=balon
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
POSTGRES_DB=balon

# === API ===
API_PORT=8080
AUTO_MIGRATE=true

# === Image version ===
VERSION=latest

# === Keycloak ===
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# API → Keycloak: koristi internal compose hostname za interno powering
# Za production sa odvojenim auth host-om, koristi public URL (https://auth.balon.dev/realms/balon)
KEYCLOAK_ISSUER=http://keycloak:8080/realms/balon
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/balon/protocol/openid-connect/certs

# Set na 'true' za dev fallback (header-based tenant). NIKAD u produkciji.
DEV_ALLOW_HEADERS=false

# === Reverse proxy (Caddy, opcionalno) ===
# DOMAIN=balon.tvojdomen.ba
# AUTH_DOMAIN=auth.tvojdomen.ba
# ACME_EMAIL=admin@tvojdomen.ba
